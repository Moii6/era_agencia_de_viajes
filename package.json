{
  "name": "erp-agencia-de-viajes",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @erp/db generate",
    "db:migrate": "pnpm --filter @erp/db migrate:dev",
    "db:studio": "pnpm --filter @erp/db studio",
    "db:seed": "pnpm --filter @erp/db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
